{
  "name": "tgfx-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "scripts": {
    "specs": "bun --cwd packages/react-native-tgfx run specs",
    "typecheck": "bun --cwd packages/react-native-tgfx run typecheck",
    "example": "bun --cwd apps/example",
    "lint-cpp": "bash scripts/clang-format.sh",
    "release": "bash scripts/release.sh",
    "bootstrap": "bash scripts/tgfx-prebuilt.sh"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "release-it": "^21.0.1",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "react-native-vision-camera@5.2.0": "patches/react-native-vision-camera@5.2.0.patch",
    "@react-native-harness/runtime@1.3.0": "patches/@react-native-harness%2Fruntime@1.3.0.patch"
  },
  "version": "0.1.0",
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:bump": "bun install"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/react-native-tgfx/package.json",
            "path": "version"
          },
          {
            "file": "packages/react-native-tgfx-vision-camera/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        }
      }
    }
  }
}

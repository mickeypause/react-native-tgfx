{
  "name": "react-native-tgfx",
  "version": "0.1.0",
  "description": "A declarative, Skia-style GPU 2D canvas for React Native, backed by Tencent's tgfx and built with Nitro Modules.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/consumer-rules.pro",
    "android/src",
    "android/libs",
    "android/libs-vulkan",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "ios/libs",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE",
    "NOTICE",
    "cpp/Buffers/*.cpp",
    "cpp/Buffers/*.hpp",
    "cpp/Core/*.cpp",
    "cpp/Core/*.hpp",
    "cpp/Export/*.cpp",
    "cpp/Export/*.hpp",
    "cpp/Image/*.cpp",
    "cpp/Image/*.hpp",
    "cpp/Offscreen/*.cpp",
    "cpp/Offscreen/*.hpp",
    "cpp/Path/*.cpp",
    "cpp/Path/*.hpp",
    "cpp/Render/*.cpp",
    "cpp/Render/*.hpp",
    "cpp/Scene/*.cpp",
    "cpp/Scene/*.hpp",
    "cpp/TextLayout/*.cpp",
    "cpp/TextLayout/*.hpp",
    "cpp/third_party/harfbuzz",
    "cpp/third_party/tgfx/LICENSE.txt",
    "cpp/third_party/tgfx/include"
  ],
  "scripts": {
    "prepack": "npx --no-install tsc --build --force && ls lib/index.js lib/index.d.ts LICENSE NOTICE android/libs/arm64-v8a/libtgfx.a android/libs-vulkan/arm64-v8a/libtgfx.a ios/libs/libtgfx.xcframework/Info.plist > /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf android/build node_modules/**/android/build lib tsconfig.tsbuildinfo",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint:check": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typescript": "tsc",
    "specs": "tsc --noEmit false && nitrogen --logLevel=\"debug\"",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/react-native-tgfx.git"
  },
  "author": "Ritesh Shukla <riteshkumarshukla04@gmail.com> (https://github.com/riteshshukla04)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-tgfx/issues"
  },
  "homepage": "https://github.com/margelo/react-native-tgfx#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "release-it": {
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "git": false,
    "github": {
      "release": false
    }
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.85.3",
    "@types/react": "^19.2.15",
    "@types/react-reconciler": "0.33.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nitrogen": "*",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "^4.4.0",
    "react-native-worklets": "^0.11.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5",
    "react-native-reanimated": "*",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
